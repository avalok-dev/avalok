{
  "name": "@visual-system/instrumented-ai-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/telemetry.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "node --experimental-strip-types src/server.ts",
    "lint": "eslint src",
