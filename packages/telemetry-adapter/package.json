{
  "name": "@visual-system/telemetry-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./observability": "./src/observability.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
