{
  "name": "ai-system-visualizer",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@visual-system/web --filter=@visual-system/collector",
